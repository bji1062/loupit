# loupit server 환경변수 예시 (SP-API config).
# JWT/OAuth 키 없음 — 비밀번호·소셜 로그인 영구 제외(INV-1·NFR16·SC10).
# 실제 값은 server/.env 로 복사(gitignore). 익명 읽기 배포는 아래 키만 쓴다.
# SC14 참여(M9: 로그인·재직인증·복지편집) 키 전체는 infra/env/server.env.example 참조 —
# `M9_ENABLED` 가 참여 라우터와 정책 문안을 동시에 지배한다(미설정=OFF, 빈값은 부팅 실패).

# --- DB (loopback, 최소권한 읽기 전용 계정) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=loupit_ro
DB_PASSWORD=change_me
DB_NAME=loupit

# --- CORS (동일 오리진 배포 — 개발 시에만 사용, INV-7) ---
CORS_ALLOW_ORIGINS=http://localhost:8000

# --- 참조 번들 인메모리 캐시 TTL(초) — reference/all: public, max-age=3600 ---
REFERENCE_CACHE_TTL=3600
