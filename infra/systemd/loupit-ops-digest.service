# /etc/systemd/system/loupit-ops-digest.service
# 운영자 큐 일일 요약(재직 승인·회사 등록 요청·발송 억제) 1회성 유닛.
# loupit-ops-digest.timer 가 스케줄한다. 2026-07-29 신설 — 그전까지 알림이 전무했고
# 회사 등록 요청 #1 이 약 1시간 40분 방치됐다(운영자가 CLI 를 치기 전까지 아무도 몰랐다).
[Unit]
Description=loupit 운영자 큐 일일 요약 메일
After=mysql.service network-online.target
Wants=mysql.service

[Service]
Type=oneshot
# server/.env(600, ubuntu 소유)를 ops.py 가 직접 load_dotenv 로 읽는다 → 같은 사용자여야 한다.
# EnvironmentFile 을 따로 두지 않는 이유: DB·SMTP·OPS_DIGEST_TO 가 전부 그 파일에 있고,
# 자격증명을 두 곳에서 관리하면 한쪽만 바뀐다.
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/loupit
# `--send` 는 **타이머만** 붙인다. 사람이 확인차 `ops digest` 를 칠 때는 발송되지 않는다.
# `--only-if-pending` 은 의도적으로 쓰지 않는다 — 큐가 비어도 보내야 침묵이 "고장"으로 읽힌다.
ExecStart=/usr/bin/python3 -m server.ops digest --send

StandardOutput=journal
StandardError=journal
SyslogIdentifier=loupit-ops-digest

[Install]
WantedBy=multi-user.target
